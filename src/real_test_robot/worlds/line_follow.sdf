<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="line_follow">

    <!-- SCENE SETTINGS -->
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 1.0 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- SUN -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.0</intensity>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- GROUND -->
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <box>
              <size>6 6 0.02</size>
            </box>
          </geometry>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <box>
              <size>6 6 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- BLACK LINE -->
    <model name="black_line">
      <static>true</static>
      <pose>0 0 0.021 0 0 0</pose>
      <link name="black_line_link">
        <visual name="black_line_visual">
          <geometry>
            <box>
              <size>4.5 0.08 0.01</size>
              <!-- length x width x height -->
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- NWALL -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 3 0.5 0 0 0</pose>
      <link name="north_wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>6 0.10 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>6 0.10 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- SWALL -->
    <model name="south_wall">
      <static>true</static>
      <pose>0 -3 0.5 0 0 0</pose>
      <link name="south_wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>6 0.10 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>6 0.10 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- EWALL -->
    <model name="east_wall">
      <static>true</static>
      <pose>3 0 0.5 0 0 0</pose>
      <link name="east_wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 6 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 6 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- WWALL -->
    <model name="west_wall">
      <static>true</static>
      <pose>-3 0 0.5 0 0 0</pose>
      <link name="west_wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 6 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 6 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>